# Prebuilt Banking AI Transfer Agent — Environment Configuration
# Copy this file to .env and fill in the values.

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production-use-a-long-random-string
FLASK_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to project root)
DATABASE_URL=sqlite:///banking_demo.db

# LangGraph SqliteSaver 체크포인트 DB (멀티턴 상태 영속화)
CHECKPOINT_DB_PATH=banking_checkpoints.db

# ── LLM Mode ─────────────────────────────────────────────────────────────────
# "openai" (기본) 또는 "deterministic".
# openai 라도 OPENAI_API_KEY 가 비어 있으면 자동으로 결정론 모드로 폴백합니다.
LLM_PROVIDER=openai

# OpenAI settings
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Business Rules ───────────────────────────────────────────────────────────
# Interbank fee in KRW (applied when source bank != destination bank)
INTERBANK_FEE=500

# OTP threshold: transfers above this amount require a mock OTP
# (보안강화 고객은 SecurityAgent 룰에 의해 100만원부터 OTP 강제)
OTP_THRESHOLD=3000000

# Demo OTP code (always valid in demo mode)
DEMO_OTP_CODE=123456

# ── LangSmith (선택) ─────────────────────────────────────────────────────────
# https://smith.langchain.com 에서 API 키 발급
# 설정하면 LangGraph 실행 트레이스가 자동으로 LangSmith에 기록됩니다.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=banking-transfer-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Demo User ────────────────────────────────────────────────────────────────
# 기본 사용자 (채팅 화면의 드롭다운으로 전환 가능: 1=이병민, 2=김은숙, 3=박준혁)
DEMO_USER_ID=1
