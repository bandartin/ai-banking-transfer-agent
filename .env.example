# Prebuilt Banking AI Transfer Agent — Environment Configuration
# Copy this file to .env and fill in the values.

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production-use-a-long-random-string
FLASK_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to project root)
DATABASE_URL=sqlite:///banking_demo.db

# LangGraph SqliteSaver 체크포인트 DB (멀티턴 상태 영속화)
CHECKPOINT_DB_PATH=banking_checkpoints.db

# ── LLM Mode ─────────────────────────────────────────────────────────────────
# "openai" (기본) 또는 "deterministic".
# openai 라도 OPENAI_API_KEY 가 비어 있으면 자동으로 결정론 모드로 폴백합니다.
LLM_PROVIDER=openai

# OpenAI settings
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenAI Tool Calling (Phase 1)
# Enabled only when LLM_PROVIDER=openai and a valid OpenAI credential is available.
# Phase 1 exposes read-only tools: balances, history, recurring transfers,
# recipient recommendations, menu/product guide search, and finance calculator.
TOOL_CALLING_ENABLED=true
# Phase 2 preview. Keep false until transfer-prep HITL handoff is enabled.
TOOL_CALLING_TRANSFER_PREP_ENABLED=false
# OPENAI_TOOL_MODEL=gpt-4o-mini
TOOL_CALLING_MAX_STEPS=4

# Phase 9 optional AWX MCP tools. Keep disabled until the MCP allowlist,
# side-effect review, and AWX bootstrap prefetch are approved.
TOOL_CALLING_AWX_MCP_ENABLED=false
# JSON object or CSV. Only read/prepare side effects are accepted.
# TOOL_CALLING_AWX_MCP_ALLOWLIST={"awx-mcp-read-tool":"read"}
# TOOL_CALLING_AWX_MCP_ALLOWLIST=awx-mcp-read-tool:read,awx-mcp-prepare-tool:prepare
# Select a specific MCP server only when more than one is available.
# AWX_MCP_SERVER_NAME=
# AWX_MCP_SERVICE_ID=

# ── AWX / AgenticWorks (선택) ────────────────────────────────────────────────
# AWX 런타임에서는 OPENAI_API_KEY를 직접 넣기보다 Portal Credential을 우선 사용합니다.
# 값이 비어 있으면 로컬 OPENAI_API_KEY 또는 결정론 모드로 폴백합니다.
# AWX_CREDENTIAL_SERVICE_ID=30
AWX_CREDENTIAL_PROVIDER_ALIAS=OpenAI
AWX_CREDENTIAL_SERVICE_TYPE_NAME=LLM
AWX_CREDENTIAL_VARIABLE_NAME=OPENAI_API_KEY
AWX_EXTERNAL_RESOURCE_SOLUTION_ID=BUILDER

# ── Integration Adapters ────────────────────────────────────────────────────
# BANKING_ADAPTER:
#   mock = 현재 SQLite 데모 DB
#   ibk  = 실제 IBK API/MCI/ESB adapter (인터페이스 확정 후 구현)
BANKING_ADAPTER=mock

# TRANSFER_EXECUTION_MODE:
#   mock    = 데모 DB에 실제 반영
#   dry_run = 실행 성공처럼 응답하되 잔액/내역 미반영
#   live    = 실제 이체 실행 adapter에서만 사용
TRANSFER_EXECUTION_MODE=mock

# KNOWLEDGE_ADAPTER:
#   mock = 로컬 샘플 지식
#   awx  = AWX 지식저장소 adapter 우선, 실패 시 mock fallback
KNOWLEDGE_ADAPTER=mock

# ── Business Rules ───────────────────────────────────────────────────────────
# Interbank fee in KRW (applied when source bank != destination bank)
INTERBANK_FEE=500

# OTP threshold: transfers above this amount require a mock OTP
# (보안강화 고객은 SecurityAgent 룰에 의해 100만원부터 OTP 강제)
OTP_THRESHOLD=3000000

# Demo OTP code (always valid in demo mode)
DEMO_OTP_CODE=123456

# ── LangSmith (선택) ─────────────────────────────────────────────────────────
# https://smith.langchain.com 에서 API 키 발급
# 설정하면 LangGraph 실행 트레이스가 자동으로 LangSmith에 기록됩니다.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=banking-transfer-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── OpenTelemetry / LangChain instrumentation ───────────────────────────────
# AWX 실행은 awx/run-application.sh에서 opentelemetry-instrument로 시작합니다.
# LangChain 도구/모델 span은 dependency가 있으면 앱 시작 시 자동 계측됩니다.
LANGCHAIN_OTEL_INSTRUMENTATION_ENABLED=true

# 금융 앱에서는 prompt/response/tool content가 민감 정보를 포함할 수 있습니다.
# 운영 기본값은 false로 유지하고, 별도 마스킹 정책이 있을 때만 true를 검토하세요.
TRACELOOP_TRACE_CONTENT=false

# 분석환경에서는 OTEL_EXPORTER_OTLP_*를 비워 두면 SDK bridge가 collector를 감지합니다.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# ── Demo User ────────────────────────────────────────────────────────────────
# 기본 사용자 (채팅 화면의 드롭다운으로 전환 가능: 1=이병민, 2=김은숙, 3=박준혁)
DEMO_USER_ID=1
