# MCP Server endpoint
MCP_SERVER_URL=http://127.0.0.1:8001/mcp/sse

# Local test identifiers for awx.resources.Credential.get()
MLDL_USER_ID=1000001
GENAI_TEXT_FLOW_ID=48

# OTEL Export
# Leave OTEL_EXPORTER_OTLP_* empty in the analysis environment unless you want
# to override the collector explicitly.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_TRACES_EXPORTER=console,otlp
OTEL_METRICS_EXPORTER=console,otlp
OTEL_LOGS_EXPORTER=console,otlp
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_LOG_LEVEL=info
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=
OPENAI_MODEL=gpt-4o-mini

# Optional: evaluation-only trace dump (SDK)
# 1 = enable, 0 = disable
AWX_OTEL_EVAL_MODE=1
# default: /tmp/awx-otel-dump
AWX_OTEL_EVAL_DUMP_DIR=/tmp/awx-otel-dump
# 1 = write /tmp/awx-otel-dump/traces/<trace_id>.jsonl
# 0 = write /tmp/awx-otel-dump/traces.jsonl
AWX_OTEL_EVAL_SPLIT_BY_TRACE=1
