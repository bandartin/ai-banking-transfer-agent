# Guardrail flow context
GENAI_TEXT_FLOW_ID=368
# Optional policy IDs applied in addition to mandatory filters.
# Comma-separated list. Leave empty to use only mandatory filters.
FILTER_POLICY_IDS=16
# OTel transmission
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_INSECURE=true
# Optional override. Leave OTEL_EXPORTER_OTLP_* empty in the analysis environment
# and let the SDK detect the injected collector endpoints automatically.

# Optional run config
HOST=0.0.0.0
PORT=8001
