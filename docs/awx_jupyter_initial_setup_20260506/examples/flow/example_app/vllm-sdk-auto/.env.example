# AWX external resource lookup context
# Defaults to awx.common.config.PLATFORM_CODE when available.
# MLDL_PLATFORM_CODE=GENTEXT

# OpenTelemetry export
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Leave OTEL_EXPORTER_OTLP_* empty in the analysis environment unless you want
# to override the collector explicitly.
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# Optional run config
HOST=0.0.0.0
PORT=8001
