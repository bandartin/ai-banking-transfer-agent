# Optional example-level overrides.
# Portal/runtime metadata is resolved by AWX runtime + SDK and is not listed here.

# Prefer a specific discovered MCP server when multiple servers are visible.
MCP_SERVER_NAME=local-calculator

# Local standalone fallback when portal MCP discovery is unavailable.
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Optional model override. The agent also accepts the model in the /chat request.
OPENAI_MODEL=gpt-4o-mini
